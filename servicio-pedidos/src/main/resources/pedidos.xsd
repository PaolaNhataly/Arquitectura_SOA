<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://shanira.tarea2/pedidos"
           targetNamespace="http://shanira.tarea2/pedidos"
           elementFormDefault="qualified">

    <!-- ===== Registrar un pedido nuevo ===== -->
    <xs:element name="registrarPedidoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="clienteId" type="xs:int"/>
                <xs:element name="productoId" type="xs:int"/>
                <xs:element name="cantidad" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="registrarPedidoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pedido" type="tns:pedido"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ===== Listar todos los pedidos ya registrados ===== -->
    <xs:element name="listarPedidosRequest">
        <xs:complexType/>
    </xs:element>

    <xs:element name="listarPedidosResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="pedido" type="tns:pedido" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="pedido">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="clienteId" type="xs:int"/>
            <xs:element name="clienteNombre" type="xs:string"/>
            <xs:element name="productoId" type="xs:int"/>
            <xs:element name="productoNombre" type="xs:string"/>
            <xs:element name="cantidad" type="xs:int"/>
            <xs:element name="precioUnitario" type="xs:decimal"/>
            <xs:element name="total" type="xs:decimal"/>
            <xs:element name="fechaRegistro" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
